	clustergrants.value AS [object_name],
	index_name.value AS index_name,
	index_privilege.value AS index_privilege,
	JSON_VALUE(index_grant.value, '$.allow_restricted_indices') AS allow_restricted_indices,
	@IDSQLServerInstance		IDSQLServerInstance,
	@SQLServerInstance		SQLServerInstance

--FROM [ELASTICAUDIT].JsonImportStaging AS t
from [elasticaudit].[t_ImportJson] t
CROSS APPLY OPENJSON(t.Json, '$.deployments') AS deployment
CROSS APPLY OPENJSON(deployment.value, '$.mappings') AS userBlock
CROSS APPLY OPENJSON(userBlock.value, '$.roles') AS rrole
CROSS APPLY OPENJSON(rrole.value, '$."cluster-grants"') AS clustergrants
CROSS APPLY OPENJSON(rrole.value, '$."index-grants"') AS index_grant
CROSS APPLY OPENJSON(JSON_QUERY(index_grant.value, '$.names')) AS index_name
CROSS APPLY OPENJSON(JSON_QUERY(index_grant.value, '$.privileges')) AS index_privilege
--WHERE FullFileNameJson like '%deployments_final_validated.json%';
WHERE FullFileNameJson not like '%db_access.json%' and FullFileNameJson not like '%federation.json%';

--select * from #json_elastic where [index_name] like '%.alert%'
--select * from #json_elastic
 --delete from  [ELASTIC].[T_SQLDatabases] 
MERGE INTO [ELASTIC].[T_SQLDatabases] as target
USING (
		select distinct d.IDSQLServerInstance, 
		d.DBid, 
		d.DBname, 
		1 [isOnline]
		from #json_elastic d		
) as source
ON target.[IDSQLServerInstance]=source.IDSQLServerInstance AND target.dbid=source.dbid
WHEN MATCHED THEN UPDATE 
	SET target.[strDatabaseName]	= source.DBname
	   ,target.[isOnline]			= source.[isOnline]
WHEN NOT MATCHED BY TARGET THEN INSERT 
	(IDSQLServerInstance, [dbid], [strDatabaseName], [dtCreateDate], [isOnline])
	values
	(source.IDSQLServerInstance, source.dbid, source.DBname, NULL, source.[isOnline])
WHEN NOT MATCHED BY SOURCE 
	THEN UPDATE SET target.[isOnline] = 0
;


--DELETE FROM [ELASTIC].[T_SQLDatabasePrincipals]

MERGE INTO [ELASTIC].[T_SQLDatabasePrincipals] as target
USING (
	select distinct 
		d.IDSQLServerInstance IDSQLServerInstance, 
		db.IDSQLDatabase,
		d.[user] AS [name], 
		'G' AS type, 
		'WINDOWS_GROUP' AS type_desc,
		0 [is_fixed_role]
	from #json_elastic d
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance
	     and db.dbid=d.dbid
	WHERE TYPEUSER = 'G'
    UNION
	select distinct 
		d.IDSQLServerInstance IDSQLServerInstance, 
		db.IDSQLDatabase,
		d.[user] AS [name], 
		'U' AS type, 
		'WINDOWS_USER' AS type_desc,
		0 [is_fixed_role]
	from #json_elastic d
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance
	     and db.dbid=d.dbid
	WHERE TYPEUSER = 'U'
	UNION
	select distinct 
		d.IDSQLServerInstance IDSQLServerInstance, 
		db.IDSQLDatabase, 
		d.[rolename] AS [name], 
		'R' AS type, 
		'DATABASE_ROLE' AS type_desc,
		1 [is_fixed_role]
	from #json_elastic d
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance
	     and db.dbid=d.dbid
) as source
ON target.IDSQLServerInstance=source.IDSQLServerInstance and target.IDSQLDatabase=source.IDSQLDatabase
   and  target.type=source.type	and target.name=source.name
WHEN MATCHED THEN UPDATE 
	SET target.[is_fixed_role]	= source.[is_fixed_role]
	, target.[type_desc] = source.[type_desc]
WHEN NOT MATCHED BY TARGET THEN INSERT 
	(IDSQLServerInstance, [IDSQLDatabase], [name], [type], [type_desc], [is_fixed_role])
	values
	(source.IDSQLServerInstance, source.IDSQLDatabase, source.[name], source.[type], source.[type_desc], [is_fixed_role])
;


--DELETE FROM [ELASTICAUDIT].[T_SQLDatabases]


MERGE INTO [ELASTICAUDIT].[T_SQLDatabases] as target
using (
select distinct 
		d.IDSQLServerInstance, 
		d.snapshot_timestamp [dtSnapshot], 
		db.IDSQLDatabase, 
		d.DBid, 
		d.DBname,  
		1 [isOnline]
from #json_elastic d
inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance
	     and db.dbid=d.dbid
) as source
ON target.[dtSnapshot]=source.[dtSnapshot]
	AND target.[IDSQLServerInstance]=source.IDSQLServerInstance 
	AND target.[IDSQLDatabase]=source.[IDSQLDatabase]
WHEN MATCHED THEN UPDATE 
	SET target.dbid					= source.dbid 
 	   ,target.[strDatabaseName]	= source.DBname
	   ,target.[isOnline]			= source.[isOnline]
WHEN NOT MATCHED BY TARGET THEN INSERT 
	(IDSQLServerInstance, [dtSnapshot], [IDSQLDatabase], [dbid], [strDatabaseName], [dtCreateDate], [isOnline])
	values
	(source.IDSQLServerInstance, source.[dtSnapshot], source.[IDSQLDatabase], source.dbid, source.DBname, NULL, source.[isOnline])
WHEN NOT MATCHED BY SOURCE 
	THEN UPDATE SET target.[isOnline] = 0
;

--DELETE FROM [ELASTICAUDIT].[T_DBPrincipals]

MERGE INTO [ELASTICAUDIT].[T_DBPrincipals] as target
USING (
	select distinct  
		d.snapshot_timestamp [dtSnapshot], 
		db.IDSQLDatabase,
		p.principal_id, 
		d.[user] AS [name], 
		'G' AS type, 
		'WINDOWS_GROUP' AS type_desc,
		0 [is_fixed_role]
	from #json_elastic d
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance and db.dbid=d.dbid
	inner join [ELASTIC].[T_SQLDatabasePrincipals] p
	  on p.[IDSQLServerInstance]=db.IDSQLServerInstance and  p.IDSQLDatabase=db.IDSQLDatabase
	     and p.name=d.[user] and p.[type]='G' 
	UNION
	select distinct  
		d.snapshot_timestamp [dtSnapshot], 
		db.IDSQLDatabase,
		p.principal_id, 
		d.[user] AS [name], 
		'U' AS type, 
		'WINDOWS_USER' AS type_desc,
		0 [is_fixed_role]
	from #json_elastic d
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance and db.dbid=d.dbid
	inner join [ELASTIC].[T_SQLDatabasePrincipals] p
	  on p.[IDSQLServerInstance]=db.IDSQLServerInstance and  p.IDSQLDatabase=db.IDSQLDatabase
	     and p.name=d.[user] and p.[type]='U' 
	UNION
	select distinct 
		d.snapshot_timestamp [dtSnapshot], 
		db.IDSQLDatabase, 
		p.principal_id, 
		d.[rolename] AS [name], 
		'R' AS type, 
		'DATABASE_ROLE' AS type_desc,
		1 [is_fixed_role]
	from #json_elastic d
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance  and db.dbid=d.dbid
	inner join [ELASTIC].[T_SQLDatabasePrincipals] p
	  on p.[IDSQLServerInstance]=db.IDSQLServerInstance and  p.IDSQLDatabase=db.IDSQLDatabase
	     and p.name=d.[rolename] and p.[type]='R'
) as source
ON target.[dtSnapshot]=source.[dtSnapshot] 
	AND target.idDB=source.IDSQLDatabase
	AND  target.type=source.type	
	AND target.principal_id=source.principal_id
WHEN MATCHED THEN UPDATE 
	SET  target.[name]			= source.[name]
		,target.[is_fixed_role]	= source.[is_fixed_role]
		,target.[type_desc]		= source.[type_desc]
WHEN NOT MATCHED BY TARGET THEN INSERT 
	([dtSnapshot], [idDB], principal_id, [name], [type], [type_desc], [is_fixed_role])
	values
	(source.[dtSnapshot], source.IDSQLDatabase, source.principal_id, source.[name], source.[type], source.[type_desc], [is_fixed_role])
;


