--DELETE FROM [elastic].[T_SQLDatabaseObjects]
--select * from #json_elastic where dbname='Collibra-Monitoring_PR' and [user] ='collibra_monitoring'

MERGE INTO [elastic].[T_SQLDatabaseObjects] AS target
USING (
	select distinct
		db.IDSQLDatabase,
		d.[object_name],
		'CL' AS [type],
		'cluster' AS [type_desc],
		d.Dbcreated
	from #json_elastic d 
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance
	     and db.dbid=d.dbid
	WHERE  d.[object_name] like 'cluster:%'
	UNION 
	select distinct
		db.IDSQLDatabase, 
		d.index_name [object_name],
		'X' AS [type],
		'index' AS [type_desc],
		d.Dbcreated
	from #json_elastic d 
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance
	     and db.dbid=d.dbid
) as source
ON target.[object_name]=source.[object_name] 
	AND target.IDSQLDatabase=source.IDSQLDatabase 
	AND target.type=source.type
WHEN MATCHED THEN UPDATE 
	SET target.[create_date]	=source.Dbcreated
	, target.[type_desc]		=source.[type_desc]
WHEN NOT MATCHED BY TARGET THEN INSERT 
	(IDSQLDatabase, [object_name],[type],[type_desc],[create_date])
	values
	(source.IDSQLDatabase, source.[object_name],source.[type],source.[type_desc],source.Dbcreated)
	;

--DELETE FROM [ELASTICAUDIT].[T_DBObjects]

MERGE INTO [ELASTICAUDIT].[T_DBObjects] as target
USING (
  	select distinct
		d.snapshot_timestamp, 
		db.IDSQLDatabase, 
		d.[object_name] [object_name],
		dbobj.[object_id],
		dbobj.[type],
		dbobj.[type_desc],
		d.Dbcreated
	from #json_elastic d
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance
	     and db.dbid=d.dbid
	inner join  [elastic].[T_SQLDatabaseObjects] dbobj
		  on dbobj.IDSQLDatabase=db.IDSQLDatabase
		  and dbobj.[object_name]=d.[object_name]
     WHERE  d.[object_name] NOT IN ('all')
--and d.DBname='Collibra-Monitoring_PR'
	UNION
  	select distinct
		d.snapshot_timestamp,
		db.IDSQLDatabase,
		d.[index_name] [object_name],
		dbobj.[object_id],
		dbobj.[type], 
		dbobj.[type_desc], 
		d.Dbcreated
    from #json_elastic d
	inner join  [ELASTIC].[T_SQLDatabases] db
	  on db.IDSQLServerInstance=d.IDSQLServerInstance
	     and db.dbid=d.dbid
	inner join  [elastic].[T_SQLDatabaseObjects] dbobj
		  on dbobj.IDSQLDatabase=db.IDSQLDatabase
		  and dbobj.[object_name]=d.[index_name]  
	WHERE  d.[index_name] NOT IN ('all')
--and d.DBname='Collibra-Monitoring_PR'
) as source
ON target.[dtSnapshot]=source.snapshot_timestamp 
	AND target.[object_id]	=source.[object_id] 
	AND target.idDB			=source.IDSQLDatabase 
	AND target.type			=source.type
WHEN MATCHED THEN UPDATE 
	SET target.[create_date]=source.Dbcreated
	,target.[name]	=source.[object_name]
	,target.[type_desc]		=source.[type_desc]
WHEN NOT MATCHED BY TARGET THEN INSERT 
	([dtSnapshot],[idDB],[name],[object_id],[type],[type_desc],[create_date])	     
	values
	(source.snapshot_timestamp, source.IDSQLDatabase, source.[object_name], source.[object_id], source.[type], source.[type_desc], source.Dbcreated)
	;

--DELETE FROM [ELASTICAUDIT].[T_DBPermissions]

MERGE INTO [ELASTICAUDIT].[T_DBPermissions] as target
USING (
	select distinct 
		d.snapshot_timestamp  [dtSnapshot], 
		db.IDSQLDatabase idDB, 
		0 [major_id],
		0 class, 
		'DATABASE' [class_desc],
		u.principal_id		[grantee_principal_id],
		'CO  ' [type], 
		'CONNECT' [permission_name],		
		'G' [state], 
		'GRANT' [state_desc]
    from #json_elastic d
	inner join [ELASTIC].[T_SQLDatabases] db
		on db.IDSQLServerInstance=d.IDSQLServerInstance  and db.dbid=d.dbid
	inner join [ELASTIC].[T_SQLDatabasePrincipals] u
		on u.[IDSQLServerInstance]=db.IDSQLServerInstance and  u.IDSQLDatabase=db.IDSQLDatabase
			and u.name=d.[user] and u.[type] in ('U', 'G')
	UNION
	select distinct 
		d.snapshot_timestamp  [dtSnapshot], 
		db.IDSQLDatabase idDB, 
		isnull(o.[object_id],0)  [major_id],
		1 class, 
		'OBJECT_OR_COLUMN' [class_desc],
		p.principal_id		[grantee_principal_id],
		(case when d.[object_name] like '%CREATE%' then 'CR  ' 
			  when d.[object_name] like '%DELETE%' then 'DL  ' 
		else 'SL  ' end)	[type], 
		d.[object_name] [permission_name],
		'G' [state], 
		'GRANT' [state_desc]
 from #json_elastic d 
	inner join [ELASTIC].[T_SQLDatabases] db
		on db.IDSQLServerInstance=d.IDSQLServerInstance  
			and db.dbid=d.dbid
	inner join [ELASTIC].[T_SQLDatabasePrincipals] p
		on p.[IDSQLServerInstance]=db.IDSQLServerInstance 
			and  p.IDSQLDatabase=db.IDSQLDatabase
			and p.name=d.[rolename] 
			and p.[type] in ('R','G')
	outer apply  (select distinct d.object_name  cluster_name
				  from #json_elastic d 
					inner join [ELASTIC].[T_SQLDatabases] db
						on db.IDSQLServerInstance=d.IDSQLServerInstance  
							and db.dbid=d.dbid
					inner join [ELASTIC].[T_SQLDatabasePrincipals] pp
						on pp.[IDSQLServerInstance]=db.IDSQLServerInstance and  pp.IDSQLDatabase=db.IDSQLDatabase
							and pp.name=d.[rolename] 
							and pp.[type] in ('R','G') 
							and pp.principal_id=p.principal_id
				  where d.[object_name]  LIKE 'cluster:%' and d.[object_name] NOT IN ('all') 
			) cl
	left join [elastic].[T_SQLDatabaseObjects] ou
	  on ou.[IDSQLDatabase]=db.IDSQLDatabase 
		and ou.[object_name]=cl.cluster_name 
		and ou.[type]='CL'
	left join [ELASTICAUDIT].[T_DBObjects] o 
	  on o.[dtSnapshot]=d.snapshot_timestamp 
		and o.[idDB]=db.IDSQLDatabase 
		and o.[object_id]=ou.[object_id]
	where d.[object_name] NOT IN ('all') 
		and d.[object_name]  NOT LIKE 'cluster:%'
	--and d.dbName='HUKDE_core_PR' and d.[user]='svcElasticHUKdePR1'

	UNION
	select distinct 
		d.snapshot_timestamp  [dtSnapshot], 
		db.IDSQLDatabase idDB, 
		isnull(o.[object_id],0) [major_id],
		1 class, 
		'OBJECT_OR_COLUMN' [class_desc],
		p.principal_id		[grantee_principal_id],
		(case when d.[index_privilege] like '%CREATE%' then 'CR  ' 
			 when d.[index_privilege] like '%DELETE%' then 'DL  ' 
		else 'SL  ' end)	[type], 
		d.[index_privilege] [permission_name],
		'G' [state], 
		'GRANT' [state_desc]
 from #json_elastic d 
	inner join [ELASTIC].[T_SQLDatabases] db
		on db.IDSQLServerInstance=d.IDSQLServerInstance  
			and db.dbid=d.dbid
	inner join [ELASTIC].[T_SQLDatabasePrincipals] p
		on p.[IDSQLServerInstance]=db.IDSQLServerInstance 
			and  p.IDSQLDatabase=db.IDSQLDatabase
			and p.name=d.[rolename] and p.[type] in ('R','G')
	left join [elastic].[T_SQLDatabaseObjects] ou
		on ou.[IDSQLDatabase]=db.IDSQLDatabase 
			and ou.[object_name]=d.[index_name] 
			and ou.[type]='X'
	left join [ELASTICAUDIT].[T_DBObjects] o 
		on o.[dtSnapshot]=d.snapshot_timestamp 
			and o.[idDB]=db.IDSQLDatabase 
			and o.[object_id]=ou.[object_id]
	where d.[index_name] NOT IN ('all') 
		and d.[index_privilege]  NOT IN ('all')
) as source
ON target.[dtSnapshot]=source.[dtSnapshot] 
	and target.idDB=source.idDB 
	and target.major_id=source.major_id
	and target.class=source.class 
	and target.type=source.type 
	and target.state=source.state
	and target.[grantee_principal_id] = source.[grantee_principal_id]
	and target.[permission_name] = source.[permission_name]
WHEN MATCHED THEN UPDATE
SET  target.[state_desc]=source.[state_desc]
	,target.[class_desc]=source.[class_desc]
WHEN NOT MATCHED BY TARGET THEN INSERT 
	([dtSnapshot], [idDB], [class], [class_desc], major_id, [grantee_principal_id], [type], [permission_name], [state], [state_desc])
	values
	(source.[dtSnapshot], source.idDB, source.[class], source.[class_desc], source.major_id, source.[grantee_principal_id], source.[type], source.[permission_name], source.[state], source.[state_desc])
;
--END
