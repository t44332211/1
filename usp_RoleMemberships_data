						ON [rmpiam].[HUKuid-1] = SUBSTRING(rmp.name, CHARINDEX('\', rmp.name) + 1, LEN(rmp.name) - CHARINDEX('\', rmp.name))
					WHERE p.[dtSnapshot] = CONVERT(SMALLDATETIME, @latecert, 102)
					AND p.idDB = @idDB
--					AND CASE p.class_desc WHEN 'OBJECT_OR_COLUMN' THEN CASE ISNULL(c.name, '*') WHEN '*' THEN o.type_desc ELSE 'COLUMN' END ELSE p.class_desc END IS NOT NULL
					AND p.permission_name <> 'CONNECT') AS perm_alt
			ON perm_neu.RoleName = perm_alt.RoleName AND perm_neu.[Member] = perm_alt.[Member] AND perm_neu.MemberType = perm_alt.MemberType
			WHERE ISNULL(perm_neu.[Member], '') <> '' AND ISNULL(perm_neu.RoleName, '') <> ''
		) AS perm
		ORDER BY [RoleName], [Member]
	END
END
