		DECLARE @idDB INT = NULL;

		SELECT @idDB = IDSQLDatabase FROM [mssqlauditreport].[get_OverviewDatabases_online](@serverName) 
		WHERE Datenbankname = @dbName

		SELECT DISTINCT perm.Global, perm.Member, perm.MemberType, perm.ADGroupLink, perm.RoleName, '' AS [Bemerkung], perm.lastChange, perm.sign_compare -- finales SELECT
		FROM ( -- Vergleichs-Flag wird ermittelt
		SELECT perm_neu.*, 
				CASE WHEN perm_neu.[Member] IS NULL AND perm_alt.[Member] IS NOT NULL THEN 'DEL'
						WHEN perm_neu.[Member] IS NOT NULL AND perm_alt.[Member] IS NULL THEN 'NEW'
						ELSE 'SAME' 
				END AS sign_compare 
		FROM  ( 
			SELECT 'Role Memberships' AS Global
						, CASE WHEN tee.type NOT IN ('A', 'R') THEN CASE ISNULL(iam.sn, '') WHEN '' THEN ISNULL(tee.name, '') ELSE tee.name + ' (' + ISNULL(iam.sn, '') + ', ' + ISNULL(iam.givenname, '') + ' ' + iam.HUKorga + ')' END ELSE CASE ISNULL(rmpiam.sn, '') WHEN '' THEN ISNULL(rmp.name, '') ELSE rmp.name + ' (' + ISNULL(rmpiam.sn, '') + ', ' + ISNULL(rmpiam.givenname, '') + ' ' + rmpiam.HUKorga + ')' END END AS [Member]
						, CASE WHEN tee.type IN ('A', 'R') THEN tee.name ELSE '' END AS RoleName
						--, CASE p.class_desc WHEN 'SCHEMA' THEN ss.name WHEN 'TYPE' THEN ts.name ELSE ISNULL(s.name, '*') END AS [Schema]
						--, CASE p.class_desc WHEN 'OBJECT_OR_COLUMN' THEN CASE ISNULL(c.name, '*') WHEN '*' THEN o.type_desc ELSE 'COLUMN' END ELSE p.class_desc END AS [Type]
						, rmp.type_desc AS MemberType
						--, p.state_desc AS [AccessType]
						--, p.permission_name AS Privilege
						, CASE ISNULL(rmp.type_desc, '') WHEN 'WINDOWS_GROUP' THEN 'https://clima.lan.huk-coburg.de/GroupInfo2/Home/Members/' + SUBSTRING(rmp.name, CHARINDEX('\', rmp.name) + 1, LEN(rmp.name) - CHARINDEX('\', rmp.name)) ELSE '' END AS ADGroupLink
