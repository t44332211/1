	@dbName		NVARCHAR(max) = NULL,  --for multiple values
	@snapshot	NVARCHAR(max) = NULL,  --for multiple values
    @personrole NVARCHAR(max) = NULL,  --for multiple values
	@latecert   NVARCHAR(max) = NULL,  --for multiple values
	@whitelist	BIT = 1
