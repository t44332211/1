
  CREATE OR REPLACE FORCE EDITIONABLE VIEW "PS733"."REZUDB_ORACLE_DATABASES" ("SOURCE", "CMDB_NAME", "CI_ID", "DB_NAME", "ORA_LDAP_ALIAS", "PHASE", "ENVIRONMENT", "ZUSTAND", "SLA", "WAF", "DATA_ENABLER", "DATA_OWNER", "DATA_STEWARD", "DBA", "APPLICATION_NAME", "SHORTCUT", "DESCRIPTION", "ORGA", "SBK", "JDBC_URL", "COLLECTION_TIMESTAMP") AS 
  WITH base_data AS (
  SELECT *
  FROM (
    SELECT A.*,
           ROW_NUMBER() OVER (PARTITION BY A.PDB_NAME ORDER BY A.PDB_NAME) AS rn
    FROM PS733.HUK_DBA_USERS A
 WHERE  A.PDB_NAME LIKE 'P_%'
      AND A.USERNAME NOT IN ('LIQUIBASE', 'XSTRM_CDB_QLIK_ADMIN')
  )
  WHERE rn = 1
),
data_enabler AS (
 SELECT APPL_ID, LISTAGG(USER_ID, ', ') WITHIN GROUP (ORDER BY USER_ID) AS DATA_ENABLER
 FROM PS733.ITEMS_APPLICATION_RESPONSIBILITIES
 WHERE RR_ID IN (10, 11, 12)
 GROUP BY APPL_ID
),
data_steward AS (
 SELECT APPL_ID, LISTAGG(USER_ID, ', ') WITHIN GROUP (ORDER BY USER_ID) AS DATA_STEWARD
 FROM PS733.ITEMS_APPLICATION_RESPONSIBILITIES
 WHERE RR_ID IN (13, 14, 15)
 GROUP BY APPL_ID
),
dba_users AS (
 SELECT APPL_ID, LISTAGG(USER_ID, ', ') WITHIN GROUP (ORDER BY USER_ID) AS DBA
 FROM PS733.ITEMS_APPLICATION_RESPONSIBILITIES
 WHERE RR_ID IN (1, 2, 3)
 GROUP BY APPL_ID
),
data_owner AS (
 SELECT APPL_ID, MAX(USER_ID) AS DATA_OWNER
 FROM PS733.ITEMS_APPLICATION_RESPONSIBILITIES
 WHERE RR_ID = 16
 GROUP BY APPL_ID
),
onn_ldap_info AS (
select DB_ID, LISTAGG(CN, ', ') WITHIN GROUP (ORDER BY CN) AS ORA_LDAP_ALIAS
FROM PS733.ITEMS_ONN_LDAP_ALIASES
WHERE DB_ID IS NOT NULL
AND CN NOT LIKE '%_REDO'
AND CN NOT LIKE '%_DUPLICATE'
GROUP BY DB_ID
)
SELECT
 'ORACLE' AS SOURCE,
 CIS.TITLE AS CMDB_NAME,
 CIS.CI_NUMMER AS CI_ID,
 A.PDB_NAME as DB_NAME,
 ONN.ORA_LDAP_ALIAS,
 CIS.PHASE,
 B.ENVIRONMENT,
 CIS.ZUSTAND,
 C.SLA_ID AS SLA,
 C.WAF_ID AS WAF,
 EN.DATA_ENABLER,
 OW.DATA_OWNER,
 ST.DATA_STEWARD,
 DBA.DBA,
 C.NAME AS APPLICATION_NAME,
 C.SHORTCUT,
 C.DESCRIPTION,
 D.VERANTWORTLICHER AS ORGA,
 C.PROTECTIONCLASS AS SBK,
 B.JDBC_URL,
 A.COLLECTION_TIMESTAMP
FROM base_data A
LEFT JOIN PS733.ITEMS_MATCHING_APP_DB B
 ON A.DBID = TO_CHAR(B.DB_ID)
LEFT JOIN PS733.ITEMS_APPLICATIONS C
 ON B.APPL_ID = C.APPL_ID
LEFT JOIN PS733.ITEMS_HUK_PLK_ENTRIES D
 ON B.PLK_ID = D.PLK_ID
LEFT JOIN data_enabler EN
 ON B.APPL_ID = EN.APPL_ID
LEFT JOIN data_steward ST
 ON B.APPL_ID = ST.APPL_ID
LEFT JOIN dba_users DBA
 ON B.APPL_ID = DBA.APPL_ID
LEFT JOIN data_owner OW
 ON B.APPL_ID = OW.APPL_ID
LEFT JOIN PS733.ITEMS_OMNITRACKER O
 ON A.DBID = O.DB_ID
LEFT JOIN PS733.ITEMS_HUK_CMDB_CIS CIS
 ON B.CI_ID = CIS.CI_NUMMER
 LEFT JOIN onn_ldap_info ONN
 ON A.DBID = ONN.DB_ID;

