	[FileName]	 nvarchar(255) NOT NULL,
	StagingTable nvarchar(255) NOT NULL,
	TableName	 nvarchar(255) NOT NULL,
	MergeCondition  nvarchar(255) NOT NULL,
	orderby		 int,
	constraint UNQ_DIM_TABLE_MAPPING UNIQUE ([FileName])
)
