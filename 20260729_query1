;WITH Rows AS (
    SELECT TRIM(value) AS row
    FROM STRING_SPLIT(@data, char(13))
    WHERE TRIM(value) <> ''
),
Parsed AS (
    SELECT x.value('(col[1])[1]', 'NVARCHAR(MAX)') AS [oid], x.value('(col[2])[1]', 'NVARCHAR(MAX)') AS [roleid], x.value('(col[3])[1]', 'NVARCHAR(MAX)') AS [member], x.value('(col[4])[1]', 'NVARCHAR(MAX)') AS [grantor], x.value('(col[5])[1]', 'NVARCHAR(MAX)') AS [admin_option], x.value('(col[6])[1]', 'NVARCHAR(MAX)') AS [inherit_option], x.value('(col[7])[1]', 'NVARCHAR(MAX)') AS [set_option]
    FROM Rows
    CROSS APPLY (
        SELECT CAST(
            '<root><col>'
            + REPLACE(row, ',', '</col><col>')
            + '</col></root>'
            AS XML
        )
    ) AS t(xmlData)
    CROSS APPLY xmlData.nodes('/root') AS n(x)
)
MERGE INTO [postgresaudit].[T_AuthMembers] as t
USING (
SELECT @FileTime dtSnapshot, [oid],[roleid],[member],[grantor],[admin_option],[inherit_option],[set_option]
FROM Parsed) as s 
ON (t.dtSnapshot=s.dtSnapshot and t.oid=s.oid)
